# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sentry — paste the DSN from https://sentry.io after creating a project.
# Leave empty to disable Sentry (the app will run normally without it).
# VITE_SENTRY_DSN=https://<key>@o<orgid>.ingest.sentry.io/<projectid>

# Apple credentials for notarization (required for signed public distribution)
# Get these from: https://appleid.apple.com -> App-Specific Passwords
#
# APPLE_ID=you@example.com
# APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
# APPLE_TEAM_ID=XXXXXXXXXX   (find in developer.apple.com -> Membership)
