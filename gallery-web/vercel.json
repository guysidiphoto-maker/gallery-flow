{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/:slug/gallery/:id", "destination": "/api/gallery-page" },
    { "source": "/:business/:gallery", "destination": "/api/gallery-page" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/retry-failed-sends", "schedule": "0 0 * * *" }
  ]
}
